# Example environment for DSP Traffic Regression E2E.
# Copy to e2e_config.env (or pass --config) and adjust for the lab.

# Execution provider: local | webshell
E2E_PROVIDER=local

# Operational profile: normal | high (default: normal)
E2E_PROFILE=normal

# Target CIDR for discovery-first traffic
E2E_TARGET_NET=10.10.10.0/24

# Capture interface (tcpdump -i)
E2E_INTERFACE=ens34

# Output root (run artifacts + reports written under a timestamped subdir)
E2E_OUTPUT_DIR=

# Webshell options (required when E2E_PROVIDER=webshell)
E2E_WEBSHELL_URL=http://10.10.10.50:8080/shell.jsp
E2E_WEBSHELL_TYPE=jsp

# DSP command (default: auto-detect repo .venv/bin/dsp or dsp on PATH)
# E2E_DSP_COMMAND=/home/aella/xdr-poc-script/.venv/bin/dsp

# Optional: force DSP runs directory for this E2E run
# DSP_RUNS_DIR=/tmp/dsp-e2e-runs
